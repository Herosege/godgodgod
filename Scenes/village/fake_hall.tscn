text = "THIS PLACE
THE CREATION OF MY MASTER 

THERE EXIST A PLACE 
SO INFINITELY COMPLICATED
SO GRAND

THEY SAW IT AND GAVE UP EVERYTHING
THEY WANTED TO STUDY AND RECREATE IT

SACRIFICING ALL THEIR 
TIME, RESOURCES AND EFFORT"
label_settings = SubResource("LabelSettings_kadud")
metadata/_edit_lock_ = true

[node name="Label2" type="Label" parent="Stuff/Barriers/Barrier/Lore" unique_id=398240291]
offset_left = 5.0
offset_top = -112.0
offset_right = 309.0
offset_bottom = 165.0
text = "AT FIRST THEY WERE SO ECSTATIC
AND EAGER TO CREATE

BUT AFTER TIME THEY DISCOVERED
ALL THEIR EFFORTS WERE IMPERFECT


THEY TRIED EVERYTHING BUT IN THE END
IT WAS JUST A MEDIOCRE IMITATION

THEY HATED THEMSELVES"
label_settings = SubResource("LabelSettings_kadud")
horizontal_alignment = 2
metadata/_edit_lock_ = true

