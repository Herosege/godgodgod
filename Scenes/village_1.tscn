[node name="EventNode" parent="Houses/FirstIsland/Guy" instance=ExtResource("23_n066v")]
position = Vector2(314, -1614)
Type = 0
CollShape = SubResource("RectangleShape2D_n066v")
Text0 = Array[String](["Oh hey man", "God damn... I haven't seen at all ever since I moved in here", "You know, I feel so much better here than in the flower fields, best of all breathing air doesn't hurt!
"])
Text1 = Array[String](["Oh, have you been to the village?", "It's pretty far up in the sky but it's really great up there, lots of fun people", "Although I heard the rumors that The Horse God has been seen around there recently", "I wouldn't trust that though, especially beacuse of the amounts of alcohol people consume there daily"])
Text2 = Array[String](["I've been studying the arts of flowerology in the free time, I've gotten pretty good at it!", "As you can see I managed to grow some colorful ones!
", "But man... you have no idea how hard it was, like what the hell I am only changing their color!", "But hey, in the end they all look woderful!
It's a shame you won't admire them since you hate flowers so much and you know... they kill you"])

