Text0 = Array[String](["Oh hey man", "God damn... I haven't seen at all ever since I moved in here", "You know, I feel so much better here than in the flower fields, best of all breathing air doesn't hurt!
"])
Text1 = Array[String](["Oh, have you been to the village?", "It's pretty far up in the sky
but it's really great up there
"])
Text2 = Array[String](["I've been studying the arts of flowerology in the free time, as you can see I managed to grow some colorful ones!", "I also modified them to be really soft to the skin, try touching them, it's a really nice feeling! "])

