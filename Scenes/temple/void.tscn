[node name="Label" type="Label" parent="Stuff/Onen" unique_id=1744313817]
visible = false
offset_left = -254.0
offset_top = -414.0
offset_right = 307.0
offset_bottom = 33.0
text = "This place is the void.
From it's name, you would think it contains nothing.
But it's actually the opposite, it contains everything.
Though, it's not quite the opposite, weirdly these two extremes are
very similar.
This area is a noise of every possibility, basically it's worthless, 
unless you make patterns out of that randomness, create something,
a god's purpose.
And so the last god dwells here, abandoning their past creations.

But it seems like the path foward doesn't exist yet,
so come back in a month or two, it will probably be there by that time.
Anyway, hope you had a fun and see you in the future."
label_settings = SubResource("LabelSettings_1ym2h")

