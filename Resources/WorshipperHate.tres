[sub_resource type="Resource" id="Resource_b1kjm"]
script = ExtResource("1_b1kjm")
MStr = Array[String](["HANIA IS A HATEFUL BEING, AN AWFUL EXISTENCE OF MISERY, THE WORST GOD THAT EVER WAS", "THEY CREATED ALL OF US, BUT I DID NOT WANT THIS AND I HATE FEELING EVERYTHING THAT I DO", "I WAS JUST HAPPY LOOKING UP TO THE HEAVENS WITH ADMIRATION AND IGNORANCE", "WHY DID I BECOME THIS, SOMEONE PLEASE FIX ME, I DID NOT WANT TO KNOW", "PLEASE FIX ME I WANT TO BE HAPPY ONCE AGAIN PLEASE, PLEASE, PLEASE", "WHY DON'T YOU LISTEN TO ME, WHY, WHY, JUST WHY!??!!?!?!!?!"])
