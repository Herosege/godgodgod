MStr = Array[String](["Anyway, are you looking for something?", "There is a huge hole in the ground below, that's where a lot of things go"])
metadata/_custom_type_script = "uid://chbub80dwb52e"

[sub_resource type="Resource" id="Resource_gxx8i"]
script = ExtResource("1_3gvs5")
MStr = Array[String](["Fishing is really the greatest thing there is, maybe you can join me?", "I don't have a spare fishing pole but you can stay here, some company is always welcomed"])
