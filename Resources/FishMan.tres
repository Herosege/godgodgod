[sub_resource type="Resource" id="Resource_3gvs5"]
script = ExtResource("1_3gvs5")
MStr = Array[String](["Dang, I been sitting here for hours and only catched a measly grapefish!", "I gotta say, the west side has way better catches", "...Oh, good day to you", "Are you planning to jump off to the east here?", "Well I don't think it's a really good idea", "Through the clouds I've seen some weird floating hands moving at huge speeds there"])
metadata/_custom_type_script = "uid://chbub80dwb52e"

[sub_resource type="Resource" id="Resource_bknqj"]
