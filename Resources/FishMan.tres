[sub_resource type="Resource" id="Resource_3gvs5"]
script = ExtResource("1_3gvs5")
MStr = Array[String](["...Oh, good day to you.
Are looking for something?", "Well, the expression on your face tells me you're full of sin and agony, so you're probably looking for the way to the temple, right?", "Unfortunately for you, when the horse attacked our village, it also broke the entrance to the temple and don't ask me how is that even possible.", "But do not worry, there is another way.
Far to the east, there is the holy fountain, it shall grant you the passage.", "Though I saw some strange things floating above the ground on the path there, so maybe you should find another way down there."])
metadata/_custom_type_script = "uid://chbub80dwb52e"

[sub_resource type="Resource" id="Resource_gxx8i"]
script = ExtResource("1_3gvs5")
MStr = Array[String](["Some time ago the horse attacked our village and I was able to scare it off by attacking it with my fishing rod.", "Unfortunately the horse killed three of our people, but I will be honest, I am glad they are finally able to rest.", "The pain of life has been weighting down on all of us and it was and it still is getting worse day by day.", "I am able to endure it, but many others could not and I've seen their suffering, their fear and their desperate prayers.", "But nobody who could meaningfully help them ever heard their pleads and so all of their hope was eradicated."])
metadata/_custom_type_script = "uid://chbub80dwb52e"

[sub_resource type="Resource" id="Resource_bknqj"]
script = ExtResource("1_3gvs5")
MStr = Array[String](["Death is a scary thing, but I think it's not entirely bad. We often run away from it just for the sake of prolonging our existence, but accepting it is in some cases the best choice.", "Though, it's not easy."])
metadata/_custom_type_script = "uid://chbub80dwb52e"

[sub_resource type="Resource" id="Resource_oh5jq"]
script = ExtResource("1_3gvs5")
MStr = Array[String](["Well, good luck in your journey to the temple. May you find the thing you were looking for."])
metadata/_custom_type_script = "uid://chbub80dwb52e"

[resource]
script = ExtResource("2_bknqj")
