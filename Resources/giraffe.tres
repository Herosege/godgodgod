[sub_resource type="Resource" id="Resource_0jich"]
script = ExtResource("1_0jich")
MStr = Array[String](["Oh... hello...
Where do you think are we?", "This space does not exist when viewed from outside of the temple, you can't see that huge tower, clouds or anything at all.", "Looking down, all I can see is darkness.
But looking up, you can see the firmament of the world.", "I think if you jumped from here, you would fall for days until you reached the ground."])
metadata/_custom_type_script = "uid://chbub80dwb52e"

[sub_resource type="Resource" id="Resource_y2myb"]
script = ExtResource("1_0jich")
MStr = Array[String](["Anyway, I've been thinking, you know, the sun is above us, so why is it so dark here, isn't sun supposed to emit light?", "Why does the light reach the surface but not here? Or is the sun not emitting light? Man, this does not make any sense.", "This world is certainly an ugly mess, but it's also a kind of mess I love."])
metadata/_custom_type_script = "uid://chbub80dwb52e"

[sub_resource type="Resource" id="Resource_d4xjw"]
script = ExtResource("1_0jich")
MStr = Array[String](["Uhh... so how long have I been here already? To be honest I kinda lost the track of time."])
metadata/_custom_type_script = "uid://chbub80dwb52e"

