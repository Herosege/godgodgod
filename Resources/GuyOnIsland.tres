[sub_resource type="Resource" id="Resource_xqr5b"]
script = ExtResource("1_xqr5b")
MStr = Array[String](["Oh hey man", "God damn... I haven't seen at all ever since I moved in here", "You know, I feel so much better here than in the flower fields, best of all breathing air doesn't hurt!"])
metadata/_custom_type_script = "uid://chbub80dwb52e"

[sub_resource type="Resource" id="Resource_trmm4"]
script = ExtResource("1_xqr5b")
MStr = Array[String](["Oh, have you been to the village?", "It's pretty far up in the sky but it's really great up there, lots of fun people", "Although I heard the rumors that The Horse God has been seen around there recently", "I wouldn't trust that though, especially beacuse of the amounts of alcohol people consume there daily"])
metadata/_custom_type_script = "uid://chbub80dwb52e"

[sub_resource type="Resource" id="Resource_ymn66"]
script = ExtResource("1_xqr5b")
MStr = Array[String](["I've been studying the arts of flowerology in the free time, I've gotten pretty good at it!", "As you can see I managed to grow some colorful ones!
", "But man... you have no idea how hard it was, like what the hell I am only changing their color!"])
