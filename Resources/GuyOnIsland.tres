[sub_resource type="Resource" id="Resource_xqr5b"]
script = ExtResource("1_xqr5b")
MStr = Array[String](["Oh hello you funny lizard", "Are you from the flower fields?
I can tell by the look at your face", "I recently moved out of there, It's kinda weird how I didn't do that for such a long time", "You know, now that I am here I am really suprised how I even managed to stay in the flower fields for so long", "That place is miserable, breathing hurts, everything is too bright and the flowers...", "Actually... I kinda like the flowers, they are pretty and fascinating", "I studied them and learned that you can change their color!", "Don't try it though, it's a really, REALLY painful process"])
metadata/_custom_type_script = "uid://chbub80dwb52e"

[sub_resource type="Resource" id="Resource_trmm4"]
script = ExtResource("1_xqr5b")
MStr = Array[String](["Oh, have you been to the village?", "It's pretty far up in the sky but it's really great up there, lots of fun people", "Although I heard the rumors that The Horse has been seen around there recently", "I wouldn't trust that though, especially beacuse of the amounts of alcohol people consume there daily"])
metadata/_custom_type_script = "uid://chbub80dwb52e"

