[sub_resource type="Resource" id="Resource_l8lcb"]
script = ExtResource("1_l8lcb")
MStr = Array[String](["When creating us, our Great God Hania blessed us with the gift of free thought, creativity and rational thinking. We made wonderful creations, such as these purple eye devices.", "They are used to store dark energy, so breaking them will replenish your firearm's ammunition."])
