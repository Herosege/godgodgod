[sub_resource type="Resource" id="Resource_l8lcb"]
script = ExtResource("1_l8lcb")
MStr = Array[String](["The wonderous eyes that focus on you
shall bless you with dark energy renewing your weaponry", "Our Great God Hania blessed us with wonderful objects of grand power such as these", "Though their placement in this world is rather unusual..."])
