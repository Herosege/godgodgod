[resource]
script = ExtResource("1_w8at8")
Name = "Beat the game with 0 deaths"
Description = "The natural weight of death stopped having meaning to me, the pain stopped mattering and when I died, I just felt frustrated, nothing more.
But achieving the perfection was an incredible moment, the feeling of all your suffering culminating in this exact moment."
AchImage = ExtResource("1_fhej8")
