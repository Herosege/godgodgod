[resource]
script = ExtResource("1_8q3lw")
Name = "Get all of the rombs"
Description = "The romb, It probably has certain uses, but even I don't know them. However we know that once you collect them, they don't ever reappear in the places they were in, but they don't exactly disappear, they come back to the place of their true origin. That's because rombs originate from a really, really strage reality. 
It's called THE HALL, it's an absurd existence, one that becomes more complex to the point of impossibility, the more you try to understand it.
[i]A passage from \"The Book about weird stuff\" by Onen[/i]"
AchImage = ExtResource("1_1rlx6")
metadata/_custom_type_script = "uid://c4v387sglca2h"
