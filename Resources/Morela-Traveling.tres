[sub_resource type="Resource" id="Resource_05obh"]
script = ExtResource("1_05obh")
MStr = Array[String](["Today is not really a good day... don't you think?", "I knew this would come to be, but I never thought that it would happen so soon and to this degree.", "The sun was specifically made by our god to make sure this would never happen again.", "But... well, I guess we aren't safe from rotting after all, that is...", "Well, before the sun was build, I accepted that this would happen to me, but now after all this time, after learning so much sbout the world and meeting many people, I am just terrified of it.", "It's inconceivable how I was even able to put up with this, that knowledge of impending doom, it's awful, absolutely terrible!"])
metadata/_custom_type_script = "uid://chbub80dwb52e"

[sub_resource type="Resource" id="Resource_cx217"]
script = ExtResource("1_05obh")
MStr = Array[String](["So... now we will all have to endure all this and accept our deaths once again. If we succed, our fate may be a peaceful one.", "The road of acceptance is not an easy one, but there is also an another way, a way worse one,
losing all hope and will to exist.", "Both paths strive to make our end a one that does not continue after, but getting rid of your hope and will is not a pleasant experience.", ""])
metadata/_custom_type_script = "uid://chbub80dwb52e"

[resource]
