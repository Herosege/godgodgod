[sub_resource type="Resource" id="Resource_xsf5u"]
script = ExtResource("1_xsf5u")
MStr = Array[String](["These orbs with their awful bleeding glares 
hate you
", "They block any dark energy in an area
and guess what your shotgun is using as ammo", "The good thing is that most of them can be killed and the red variant doesn't reappear when slain"])
metadata/_custom_type_script = "uid://chbub80dwb52e"

[sub_resource type="Resource" id="Resource_riupx"]
script = ExtResource("1_xsf5u")
MStr = Array[String](["We don't know what any of these eyes are, or what they were made for, but we don't need to", "Because we trust in our wonderful Great God Hania's vision of reality "])
